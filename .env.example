# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL / Prisma
DATABASE_URL=postgresql://paketshop:paketshop@localhost:5432/paketshop?schema=public
# Bitta instansiya uchun maksimal ulanish (Supabase session pooler limiti — 15)
DATABASE_POOL_MAX=3
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional Supabase compatibility (customer auth, legacy blog and migration tools)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary media storage (server-only signed uploads)
# These three values are required for all admin image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=paketshopuz
# E2E testlar uchun bildirishnomalarni o'chirish (faqat test muhitida 'true')
TELEGRAM_NOTIFICATIONS_DISABLED=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=

# AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CRON_SECRET=

# Online payments are Phase 2 and disabled by default
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
NEXT_PUBLIC_PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
